# Copie para .env (o .env esta no .gitignore). NUNCA versione credenciais.

# --- S/4HANA (proxy /sap do ui5.yaml)
# Endereco do seu S/4 terminando em /sap, e o client em JSON.
UI5_MIDDLEWARE_SIMPLE_PROXY_BASEURI=https://seu-s4.exemplo.com:44300/sap
UI5_MIDDLEWARE_SIMPLE_PROXY_QUERY={"sap-client":"100"}
# Usuario/senha do SEU usuario de dialogo. Alternativa: definir como variaveis de ambiente do shell.
UI5_MIDDLEWARE_SIMPLE_PROXY_USERNAME=
UI5_MIDDLEWARE_SIMPLE_PROXY_PASSWORD=

# --- Jev (TypeSafe via OpenRouter), proxy /jev
# Vazio = simulador local (mesmo formato de resposta). Preenchido = Jev real.
# A chave e injetada pelo servidor no header Authorization: Bearer ... e nunca vai para o navegador.
OPENROUTER_API_KEY=
# Opcionais (padroes entre parenteses)
# JEV_URL=https://openrouter.ai/api/alpha/decisions   (se der 404: https://openrouter.ai/api/v1/api/alpha/decisions)
# JEV_MODEL=typesafe/jev-1.13
# JEV_TIMEOUT_MS=5000                                  (timeout do servidor; o front aborta em 1500 ms de qualquer forma)
